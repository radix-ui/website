# Cloudflare Workers static-assets redirects (copied into out/ by `next build`).
# Ported from the former `redirects()` in next.config.js, which a static export
# ignores. Status codes match what Next emitted: 308 for `permanent: true`,
# 307 otherwise. Static rules first, then dynamic rules from most to least
# specific (the top-most matching rule wins).

# Static
/case-studies /primitives/case-studies 308
/colors/docs /colors/docs/overview/installation 308
/colors/docs/tests /colors 308
/docs/colors/palette-composition/the-scales /colors/docs/palette-composition/scales 308
/docs/colors/getting-started /colors/docs/overview 308
/docs/primitives /primitives/docs/overview/introduction 307
/docs/primitives/utilities/aspect-ratio /primitives/docs/components/aspect-ratio 308
/docs/primitives/utilities/label /primitives/docs/components/label 308
/primitives/docs /primitives/docs/overview/introduction 307
/themes / 307
/themes/docs /themes/docs/overview/getting-started 307

# Dynamic
/case-studies/* /primitives/case-studies/:splat 308
/colors/docs/tests/* /colors 308
/docs/colors/getting-started/* /colors/docs/overview/:splat 308
/docs/colors/* /colors/docs/:splat 308
/docs/primitives/utilities/aspect-ratio/* /primitives/docs/components/aspect-ratio 308
/docs/primitives/utilities/label/* /primitives/docs/components/label 308
/docs/primitives/* /primitives/docs/:splat 308
/primitives/docs/components/:slug/:version /primitives/docs/components/:slug 308
/primitives/docs/utilities/:slug/:version /primitives/docs/utilities/:slug 308
